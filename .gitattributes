# Store text with LF in the repository regardless of the platform it was written
# on, so Windows checkouts do not show every line of every file as modified.
* text=auto eol=lf

# Must stay LF: a CRLF in the shebang stops the wrapper running on Linux and macOS.
gradlew text eol=lf

# Windows scripts, which need CRLF to be run by cmd and PowerShell reliably.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch these.
*.jar binary
*.bin binary
*.png binary
